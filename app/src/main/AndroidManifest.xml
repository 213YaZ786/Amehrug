<?xml version="1.0" encoding="utf-8"?>
<!--
  Notes never touches the network. The two network permissions are removed
  explicitly, so a library that declares them cannot bring them in through
  manifest merging. CI fails if the release APK asks for any permission
  outside the allow list in .github/workflows/build.yml.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The one permission Notes asks for. It lets the system show its own
      unlock prompt for the app lock, fingerprint, face or screen code. It is
      granted at install, never asks the user anything, reads no data and
      sends nothing anywhere. Without it the platform throws on the first
      call and the app dies.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <application
        android:name=".NotesApplication"
        android:allowBackup="false"
        android:appCategory="productivity"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:memtagMode="sync"
        android:supportsRtl="true"
        android:theme="@style/Theme.Notes"
        android:usesCleartextTraffic="false"
        tools:targetApi="37">

        <!--
          adjustResize: the screens take the keyboard as an inset (safeDrawing) and the
          window is never panned on top of it, which left a keyboard high gap under the
          editor when the title took focus. Compose's insets guide
          (https://developer.android.com/develop/ui/compose/system/insets, IME insets)
          and SMS's and Dialer's manifests.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pictures from outside decoded where they can reach nothing (Modules kit safemedia). -->
        <service
            android:name=".core.security.DecoderService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":decoder" />

    </application>

</manifest>
