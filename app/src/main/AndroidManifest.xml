<?xml version="1.0" encoding="utf-8"?>
<!--
  Amehrug never touches the network. The two network permissions are removed
  explicitly, so a library that declares them cannot bring them in through
  manifest merging. CI fails if the release APK asks for any permission
  outside the allow list in .github/workflows/build.yml.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The one permission Amehrug asks for. It lets the system show its own
      unlock prompt for the app lock, fingerprint, face or screen code. It is
      granted at install, never asks the user anything, reads no data and
      sends nothing anywhere. Without it the platform throws on the first
      call and the app dies.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <application
        android:name=".AmehrugApplication"
        android:allowBackup="false"
        android:appCategory="productivity"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Amehrug"
        android:usesCleartextTraffic="false"
        tools:targetApi="37">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
