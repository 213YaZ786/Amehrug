<?xml version="1.0" encoding="utf-8"?>
<!--
  A page with a folded corner, written in binary, and a padlock, in soft
  relief. Each material is a grey layer multiplied by a tone of the
  wallpaper's palette (colors.xml), so the icon follows Material You. The
  shadows and the highlights lie on top, untinted. Rendered by a script,
  never edited by hand.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap android:src="@drawable/ame_page" android:tint="@color/ic_launcher_page" android:tintMode="multiply" />
    </item>
    <item android:drawable="@drawable/ame_shadow" />
    <item>
        <bitmap android:src="@drawable/ame_lines" android:tint="@color/ic_launcher_ink" android:tintMode="multiply" />
    </item>
    <item>
        <bitmap android:src="@drawable/ame_fold" android:tint="@color/ic_launcher_fold" android:tintMode="multiply" />
    </item>
    <item>
        <bitmap android:src="@drawable/ame_shackle" android:tint="@color/ic_launcher_shackle" android:tintMode="multiply" />
    </item>
    <item>
        <bitmap android:src="@drawable/ame_lock" android:tint="@color/ic_launcher_lock" android:tintMode="multiply" />
    </item>
    <item android:drawable="@drawable/ame_shine" />
</layer-list>
