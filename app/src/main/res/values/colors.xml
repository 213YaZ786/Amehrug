<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launcher background follows the wallpaper palette.
         system_* colours are framework resources from API 31, and minSdk
         is 31, so the alias always resolves. -->
    <color name="ic_launcher_background">@android:color/system_accent1_100</color>
    <!-- The tones the icon's grey layers are multiplied by. -->
    <color name="ic_launcher_page">@android:color/system_accent1_10</color>
    <color name="ic_launcher_ink">@android:color/system_accent1_700</color>
    <color name="ic_launcher_fold">@android:color/system_accent2_100</color>
    <color name="ic_launcher_shackle">@android:color/system_neutral2_200</color>
    <color name="ic_launcher_lock">@android:color/system_accent1_600</color>
</resources>
